# Multi-stage Next.js build for ichatpp frontend.
# Goal: < 200 MB final image (target ~150 MB on node:20-alpine).
#
# Relies on Next 14's `output: 'standalone'` (set in next.config.mjs) so the
# runner image only needs the .next/standalone bundle + static + public —
# no node_modules in the final layer.

# ─────────────────────────── 1. dep install ──────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

# Build deps for any native modules pulled by the dep tree.
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
# `--include=dev` forces devDependencies even when NODE_ENV=production is
# set in the build env (Coolify and other PaaS injects this by default,
# which would otherwise drop tailwindcss/postcss/typescript and break
# `next build`).
RUN npm ci --no-audit --no-fund --include=dev

# ─────────────────────────── 2. builder ──────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build-time public env vars — these get inlined into the bundle. Adjust at
# build time via --build-arg or the orchestrator's build-arg input. They
# default to localhost so a developer building this image standalone gets
# a working dev pointer; production must override.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/ws
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ─────────────────────────── 3. runner ───────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Non-root by convention — Next 14's `next start` doesn't need root.
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Standalone output: copies only what Next needs, omitting the dev tree.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# server.js is generated by `next build` when output:'standalone'.
CMD ["node", "server.js"]
