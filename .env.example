# ichatpp local-dev environment
# Copy this file to `.env` (which is git-ignored) and adjust as needed.
# Both docker-compose.yml and the backend read from this file.

# ────────── PostgreSQL ──────────
POSTGRES_USER=ichatpp
POSTGRES_PASSWORD=ichatpp_dev
POSTGRES_DB=ichatpp
POSTGRES_PORT=5432
# Used by backend (sqlx). Host is `postgres` inside docker-compose, `localhost` from host.
DATABASE_URL=postgres://ichatpp:ichatpp_dev@localhost:5432/ichatpp

# ────────── Redis ──────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ────────── MinIO / S3-compatible object storage ──────────
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_AVATARS=avatars
S3_BUCKET_EMOJIS=emojis
S3_BUCKET_EXPORTS=exports

# ────────── Backend (Actix-web) ──────────
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,ichatpp=debug

# ────────── JWT (RS256) ──────────
# Paths to RSA key pair (PEM). Generate locally before first run, e.g.:
#   openssl genpkey -algorithm RSA -out backend/keys/jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in backend/keys/jwt-private.pem -pubout -out backend/keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=backend/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=backend/keys/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# ────────── CORS / cookies ──────────
# Frontend origin (no wildcard — browsers reject `*` with credentials).
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
# Set to `false` in local dev so Secure cookies work over plain http.
COOKIE_SECURE=false

# ────────── Frontend (Next.js) ──────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/ws
